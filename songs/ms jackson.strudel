setcpm(95/4)

const arrangement = [
  { section: 'Intro', cycles: 8 },
  { section: 'Verse 1', cycles: 16 },
  { section: 'Lift', cycles: 8 },
  { section: 'Hook', cycles: 16 },
  { section: 'Breakdown', cycles: 4 },
  { section: 'Final hook', cycles: 8 },
  { section: 'Outro', cycles: 4 },
]
const [introCycles, verseCycles, liftCycles, hookCycles, breakdownCycles, finalHookCycles, outroCycles] =
  arrangement.map(({ cycles }) => cycles)

// Mastering: drag underlined values, use arrows for lists, or click mute values.
const master = .9
const solo = 'all'
const vocalMix = { gain: 1.08, pan: .5, mute: false }
const bassMix = { gain: 1, pan: .5, mute: false }
const organMix = { gain: .82, pan: null, mute: false }
const stabsMix = { gain: .85, pan: .42, mute: false }
const runsMix = { gain: .75, pan: .58, mute: false }
const kickMix = { gain: 1.05, pan: .5, mute: false }
const snareMix = { gain: .92, pan: .5, mute: false }
const hatsMix = { gain: .8, pan: .56, mute: false }
const mix = (name, pattern, { gain = 1, pan = null, mute = false } = {}) => {
  const level = master * gain * (!mute && (solo === 'all' || solo === name) ? 1 : 0)
  const balanced = pattern.gain(level)
  return pan === null ? balanced : balanced.pan(pan)
}

const vocalPhrase = note("<[~ ~ ~ a4 e5 d5 d5 d5 ~ e5 ~ ~ a5@4] [e5 ~ e5 ~ e5 ~ g5@3 f5 e5 ~ ~ ~ ~ ~] [d5 ~ e5 ~ d5 ~ e5 ~ d5 ~ e5 d5 ~ e5 a4 ~] [a4 ~ e5 ~ d5 ~ e5 ~ d5 ~ e5 d5 ~ e5 a4 ~]>")
  .sound("vox").gain(.62).release(.8).lpf(2400).room(.32).size(3).delay(".22:.15:.28")

const bassPhrase = stack(
  note("<[f2 ~ ~ ~ ~ ~ f2 ~ ~ ~ f1 f2 ~ ~ ~ ~] [f2 ~ ~ ~ ~ ~ f2 ~ ~ ~ f2 g2 ~ ~ g2 ~] [a2 ~ ~ ~ ~ ~ a2 ~ ~ ~ a1 a2 ~ ~ a2 ~] [g2 ~ ~ ~ ~ ~ g2 ~ ~ ~ g1 g2 ~ ~ g2 ~]>")
    .sound("sine").gain(.2).lpf(150).clip(.82).release(.1),
  note("<[f2 ~ ~ ~ ~ ~ f2 ~ ~ ~ f1 f2 ~ ~ ~ ~] [f2 ~ ~ ~ ~ ~ f2 ~ ~ ~ f2 g2 ~ ~ g2 ~] [a2 ~ ~ ~ ~ ~ a2 ~ ~ ~ a1 a2 ~ ~ a1 ~] [g2 ~ ~ ~ ~ ~ g2 ~ ~ ~ g1 g2 ~ ~ g2 ~]>")
    .sound("square").gain(.15).lpf(sine.range(180,350).slow(8)).lpq(4).clip(.5).release(.1).shape(.65).postgain(.3)
)

const organPhrase = stack(
  note("<[f4,a4,c5] [[f4,a4,c5]@5 [g4,b4,d5]@3] [a4,c5,e5] [g4,b4,d5]>")
    .sound("sawtooth").release(.16).gain(.22).lpf(perlin.range(900,1120)).lpq(2).vib("5:.1").room(.38).size(4).pan(.38)
    .superimpose(x => x.add(note(.08))),
  note("<[f4,a4,c5] [[f4,a4,c5]@5 [g4,b4,d5]@3] [a4,c5,e5] [g4,b4,d5]>")
    .sound("sawtooth").release(.18).gain(.18).lpf(perlin.range(1050,1260).slow(4)).lpq(2).vib("4.5:.08").shape(.12).postgain(.5).room(.55).size(5).pan(.62)
    .superimpose(x => x.add(note(-.12)).delay(".3:.12:.5"))
)

const stabsPhrase = stack(
  note("<[[f4,a4,c5] ~@15] ~ [[a4,c5,e5] ~ ~ ~ [a4,c5,e5] ~ ~ [a4,c5,e5] [a4,c5,e5] ~@7] [[g4,b4,d5] ~ ~ ~ [g4,b4,d5] ~ ~ [g4,b4,d5] [g4,b4,d5] ~@7]>").gain(.48),
  note("<[[f5,a5,c6] ~@15] ~ [[a5,c6,e6] ~ ~ ~ [a5,c6,e6] ~ ~ [a5,c6,e6] [a5,c6,e6] ~@7] [[g5,b5,d6] ~ ~ ~ [g5,b5,d6] ~ ~ [g5,b5,d6] [g5,b5,d6] ~@7]>").gain(.3)
).sound("piano").hpf(180).clip(.55).release(.65).room(.32).size(5)

const runFill = stack(
  note("[~@6 c6 b5 a5 g5 f5 e5]").gain(.55),
  note("[~@6 c7 b6 a6 g6 f6 e6]").gain(.32)
).sound("piano").clip(.5).release(.35).delay(".2:.15:.35").room(.28).size(4)

const kickPhrase = s("bd").struct("t ~ ~ ~ ~ ~ ~ ~ ~ ~ t ~ ~ ~ ~ ~").bank("RolandTR909").gain(.22).shape(.35).release(.8).room(.06)
const snarePhrase = s("sd").struct("~ ~ ~ ~ t ~ ~ ~ ~ ~ ~ ~ t ~ ~ ~").bank("RolandTR909").gain(.38).room(.16).size(2)
const hatsPhrase = s("hh*8").bank("RolandTR909").gain("[.16 .24]*4").clip(sine.range(.04,.06).fast(2)).shape(.08).hpf(5200)

// @track vocal | Vocal
vocal$: mix('vocal',
  arrange(
    [introCycles, silence], [verseCycles, vocalPhrase.velocity(.72)], [liftCycles, vocalPhrase.velocity(.84)],
    [hookCycles, vocalPhrase], [breakdownCycles, silence], [finalHookCycles, vocalPhrase], [outroCycles, silence]
  ).orbit(1).color("#ff8844")._spiral({ stretch: .5, size: 100, thickness: 24, steady: 0, fade: .001, colorizeInactive: 0 }),
  vocalMix
)

// @track bass | Bass
bass$: mix('bass',
  arrange(
    [introCycles / 2, silence], [introCycles / 2, bassPhrase.velocity(.5)],
    [verseCycles, bassPhrase.velocity(.78)], [liftCycles, bassPhrase.velocity(.9)],
    [hookCycles, bassPhrase], [breakdownCycles, silence],
    [finalHookCycles, bassPhrase], [outroCycles, bassPhrase.velocity(.5)]
  ).orbit(2).color("dodgerblue")._scope(),
  bassMix
)

// @track organ | Organ
organ$: mix('organ',
  arrange(
    [introCycles, organPhrase.lpf(650).velocity(.55)], [verseCycles, organPhrase.velocity(.68)],
    [liftCycles, organPhrase.velocity(.82)], [hookCycles, organPhrase], [breakdownCycles, silence],
    [finalHookCycles, organPhrase], [outroCycles, organPhrase.lpf(650).velocity(.48)]
  ).orbit(3).color("magenta")._lissajous({ size: 150 }),
  organMix
)

// @track stabs | Piano stabs
stabs$: mix('stabs',
  arrange(
    [introCycles + verseCycles, silence], [liftCycles, stabsPhrase.velocity(.72)],
    [hookCycles, stabsPhrase], [breakdownCycles, silence],
    [finalHookCycles, stabsPhrase.velocity(.9)], [outroCycles, silence]
  ).orbit(4).color("cyan"),
  stabsMix
)

// @track runs | Piano runs
runs$: mix('runs',
  arrange(
    [introCycles + verseCycles + liftCycles - 1, silence], [1, runFill],
    [hookCycles - 1, silence], [1, runFill],
    [breakdownCycles + finalHookCycles - 1, silence], [1, runFill],
    [outroCycles, silence]
  ).orbit(5).color("white"),
  runsMix
)

// @track kick | Kick
kick$: mix('kick',
  arrange(
    [introCycles, kickPhrase.velocity(.55)], [verseCycles, kickPhrase.velocity(.76)],
    [liftCycles, kickPhrase.velocity(.9)], [hookCycles, kickPhrase],
    [breakdownCycles, kickPhrase.fast(2).velocity(.52)],
    [finalHookCycles, kickPhrase], [outroCycles, silence]
  ).orbit(6).color("red")._orbit({ size: 130 }),
  kickMix
)

// @track snare | Snare
snare$: mix('snare',
  arrange(
    [introCycles, silence], [verseCycles, snarePhrase.velocity(.76)],
    [liftCycles, snarePhrase.velocity(.9)], [hookCycles, snarePhrase],
    [breakdownCycles, snarePhrase.velocity(.55)], [finalHookCycles, snarePhrase], [outroCycles, silence]
  ).orbit(7).color("yellow"),
  snareMix
)

// @track hats | Hats
hats$: mix('hats',
  arrange(
    [introCycles, hatsPhrase.velocity(.45)], [verseCycles, hatsPhrase.velocity(.72)],
    [liftCycles, hatsPhrase.velocity(.9)], [hookCycles, hatsPhrase],
    [breakdownCycles, hatsPhrase.slow(2).velocity(.42)],
    [finalHookCycles, hatsPhrase], [outroCycles, silence]
  ).orbit(8).color("lime"),
  hatsMix
)
