  "matrix": [
    { "src": "env1", "dst": "amp.gain", "depth": 0.5 },
    { "src": "env2", "dst": "filter1.frequency", "depth": 2000 },
    { "src": "lfo1", "dst": "formant1.morph", "depth": 0.4 },
    { "src": "lfo2", "dst": "filter1.frequency", "depth": 800 }
  ]
