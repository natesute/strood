{
  "name": "vox",
  "modules": {
    "osc1": {
      "type": "supersaw",
      "params": {
        "voices": 5,
        "detune": 0.15
      }
    },
    "osc2": {
      "type": "sawtooth",
      "params": {}
    },
    "formant1": {
      "type": "formant",
      "params": {
        "morph": 0.0,
        "gain": 1.5
      }
    },
    "filter1": {
      "type": "svf",
      "params": {
        "frequency": 4000,
        "resonance": 0.3,
        "mode": 0
      }
    },
    "amp": {
      "type": "vca",
      "params": { "gain": 0 }
    },
    "env1": {
      "type": "env",
      "params": { "a": 0.4, "d": 0.3, "s": 0.7, "r": 1.0 }
    },
    "env2": {
      "type": "env",
      "params": { "a": 0.6, "d": 0.5, "s": 0.4, "r": 1.5 }
    },
    "lfo1": {
      "type": "lfo",
      "params": { "rate": 0.08, "shape": "sine" }
    },
    "lfo2": {
      "type": "lfo",
      "params": { "rate": 0.12, "shape": "triangle" }
    }
  },
  "routing": [
    ["osc1", "formant1"],
    ["osc2", "formant1"],
    ["formant1", "filter1"],
    ["filter1", "amp"]
