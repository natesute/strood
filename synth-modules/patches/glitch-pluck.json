{
  "name": "glitch",
  "modules": {
    "osc1": {
      "type": "square",
      "params": {}
    },
    "noise1": {
      "type": "noise",
      "params": { "type": "white" }
    },
    "filter1": {
      "type": "comb",
      "params": {
        "frequency": 400,
        "feedback": 0.85,
        "damping": 0.4
      }
    },
    "filter2": {
      "type": "svf",
      "params": {
        "frequency": 3000,
        "resonance": 0.6,
        "mode": 0
      }
    },
    "amp": {
      "type": "vca",
      "params": { "gain": 0 }
    },
    "env1": {
      "type": "env",
      "params": { "a": 0.001, "d": 0.08, "s": 0.0, "r": 0.02 }
    },
    "env2": {
      "type": "env",
      "params": { "a": 0.001, "d": 0.15, "s": 0.0, "r": 0.05 }
    },
    "rand1": {
      "type": "random",
      "params": { "rate": 8, "smooth": 0.2 }
    }
  },
  "routing": [
    ["noise1", "filter1"],
    ["filter1", "filter2"],
    ["filter2", "amp"]
  ],
  "matrix": [
    { "src": "env1", "dst": "amp.gain", "depth": 0.7 },
    { "src": "env2", "dst": "filter2.frequency", "depth": 5000 },
    { "src": "rand1", "dst": "filter1.frequency", "depth": 300 }
  ]
}
