{
  "name": "lush",
  "modules": {
    "osc1": {
      "type": "supersaw",
      "params": {
        "voices": 7,
        "detune": 0.25
      }
    },
    "filter1": {
      "type": "biquad",
      "params": {
        "type": "lowpass",
        "frequency": 3000,
        "resonance": 1.5
      }
    },
    "amp": {
      "type": "vca",
      "params": {
        "gain": 0
      }
    },
    "env1": {
      "type": "env",
      "params": {
        "a": 0.8,
        "d": 0.5,
        "s": 0.7,
        "r": 1.5
      }
    },
    "env2": {
      "type": "env",
      "params": {
        "a": 1.2,
        "d": 0.8,
        "s": 0.3,
        "r": 2.0
      }
    },
    "lfo1": {
      "type": "lfo",
      "params": {
        "rate": 0.15,
        "shape": "sine"
      }
    }
  },
  "routing": [
    ["osc1", "filter1"],
    ["filter1", "amp"]
  ],
  "matrix": [
    { "src": "env1", "dst": "amp.gain", "depth": 0.6 },
    { "src": "env2", "dst": "filter1.frequency", "depth": 2000 },
    { "src": "lfo1", "dst": "filter1.frequency", "depth": 500 }
  ]
}
